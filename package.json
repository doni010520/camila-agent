{
	"name": "camila-agent",
	"version": "1.0.0",
	"description": "Helena AI agent for Camila Rosario Academy — WhatsApp scheduling assistant",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc && node -e \"require('fs').mkdirSync('dist/agent',{recursive:true});require('fs').copyFileSync('src/agent/prompt.md','dist/agent/prompt.md')\"",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.0",
		"@supabase/supabase-js": "^2.49.0",
		"hono": "^4.7.0",
		"openai": "^4.85.0",
		"pg": "^8.13.0",
		"pino": "^9.6.0",
		"zod": "^3.24.0",
		"uuid": "^11.1.0",
		"pdf-parse": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^22.10.0",
		"@types/pg": "^8.11.0",
		"@types/uuid": "^10.0.0",
		"@vitest/coverage-v8": "^3.1.0",
		"msw": "^2.7.0",
		"pino-pretty": "^13.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0"
	}
}
